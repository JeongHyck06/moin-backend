# 이 파일을 application-local.properties 로 복사해서 쓴다, 실제 파일은 버전 관리에서 제외
# 로컬 개발 프로파일, 프로파일 지정 없는 기본값
# Swagger 는 springdoc 기본값 그대로 열린 상태

# 로컬 MySQL, 기본값은 brew 로 띄운 localhost:3306 의 moin (utf8mb4)
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/moin}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}

# 카카오 없이 닉네임만으로 로그인, 운영에서는 반드시 false
moin.dev-login=true

# ponytail: 로컬 디스크 저장, 서버 2대 이상이면 VideoStorage 만 S3 로 교체
moin.upload-dir=uploads
# Firebase 서비스 계정 json 경로, 비어 있으면 발송 없이 로그만 (파일은 gitignore)
moin.fcm.credentials=

# 앱 시작 시 GET /app/version 으로 강제(min)·권장(latest) 업데이트 안내
moin.app.min-version=1.0.0
moin.app.latest-version=1.0.0
moin.app.ios-store-url=
moin.app.android-store-url=
