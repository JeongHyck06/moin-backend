# 이 파일을 application-local.properties 로 복사해서 값을 채운다
# 실제 파일은 버전 관리에서 제외되고 이 PC 에서만 쓰므로 비밀번호·키 경로를 그대로 적어도 된다
# Swagger 는 springdoc 기본값 그대로 열린 상태

# 로컬 MySQL, 미리 moin 데이터베이스(utf8mb4)를 만들어 둘 것
spring.datasource.url=jdbc:mysql://localhost:3306/moin
spring.datasource.username=root
spring.datasource.password=

# 카카오 없이 닉네임만으로 로그인, 운영에서는 반드시 false
moin.dev-login=true

# 영상 저장 경로
moin.upload-dir=uploads
# Firebase 서비스 계정 json 절대 경로, 비어 있으면 푸시는 로그로만
moin.fcm.credentials=

# 앱 시작 시 GET /app/version 으로 강제(min)·권장(latest) 업데이트 안내
moin.app.min-version=1.0.0
moin.app.latest-version=1.0.0
moin.app.ios-store-url=
moin.app.android-store-url=
