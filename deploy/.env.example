DB_PASSWORD=generate-a-unique-password-on-the-server
MYSQL_ROOT_PASSWORD=generate-a-different-password-on-the-server
MYSQL_IMAGE=mysql:8.4
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
# Optional: expose Swagger UI and OpenAPI docs in production.
SWAGGER_ENABLED=false
# Google OAuth web client ID, comma-separated if more than one is allowed.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.moin
# Optional: place a Firebase service-account JSON in ./secrets/ and set its container path.
FCM_CREDENTIALS=
IOS_STORE_URL=
ANDROID_STORE_URL=

# 스토어 검증 키는 secrets/ 아래에 보관하고 컨테이너 경로 지정
APPLE_IAP_KEY_PATH=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
GOOGLE_PLAY_CREDENTIALS=
IAP_ALLOW_SANDBOX=false
ADMOB_ANDROID_REWARDED_UNIT=
ADMOB_IOS_REWARDED_UNIT=
